# Synclie - Boundless Learning System 環境変数テンプレート
# 実際の値は .env.local にコピーして設定する(.env.local は git 管理外)

# --- Supabase (Postgres + pgvector + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js (NextAuth) ---
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# さくらVPSなどリバースプロキシ配下で動かす場合は必須(README「さくらVPSへのデプロイ」参照)
# AUTH_TRUST_HOST=true

# 段階2: SSO (F22) を有効化する際に設定
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 段階3: LMS連携 (F17, LTI 1.3) を有効化する際に設定。
# LTI_TOOL_PRIVATE_KEY / LTI_TOOL_KEY_ID は scripts/dev/generate-lti-keys.mjs で生成できる。
# LTI_PLATFORM_* は、LMS側にSynclieをツール登録した際に発行される値。
LTI_PLATFORM_ISSUER=
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_DEPLOYMENT_ID=
LTI_PLATFORM_AUTH_LOGIN_URL=
LTI_PLATFORM_AUTH_TOKEN_URL=
LTI_PLATFORM_JWKS_URL=
LTI_TOOL_PRIVATE_KEY=
LTI_TOOL_KEY_ID=
LTI_TOOL_BASE_URL=

# --- OpenAI (ペルソナ対話・論証評価・F02のRAG埋め込み) ---
OPENAI_API_KEY=
# 任意: モデル名を上書きしたい場合のみ設定(未設定時は src/lib/ai/openai.ts のデフォルトを使う)
# SYNCLIE_MODEL_PERSONA=
# SYNCLIE_MODEL_JUDGE=
# SYNCLIE_MODEL_EMBEDDING=
