# systemd ユニット。/etc/systemd/system/synclie.service に置く。
# 配置先(WorkingDirectory)・実行ユーザーは実際のVPSに合わせて直すこと。
[Unit]
Description=Synclie - Boundless Learning System (Next.js)
After=network.target

[Service]
Type=simple
User=synclie
WorkingDirectory=/opt/synclie
EnvironmentFile=/opt/synclie/.env.local
Environment=NODE_ENV=production
Environment=PORT=3000
# 外部へは公開せず、同一ホストのnginxからのみ接続させる
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
